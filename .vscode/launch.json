{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (InternApi / http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/InternApi/bin/Debug/net10.0/InternApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/InternApi",
      "stopAtEntry": false,
      "launchSettingsFilePath": "${workspaceFolder}/src/InternApi/Properties/launchSettings.json",
      "launchSettingsProfile": "http"
    },
    {
      "name": ".NET Core Launch (InternApi / https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/InternApi/bin/Debug/net10.0/InternApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/InternApi",
      "stopAtEntry": false,
      "launchSettingsFilePath": "${workspaceFolder}/src/InternApi/Properties/launchSettings.json",
      "launchSettingsProfile": "https"
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}